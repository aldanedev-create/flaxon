# Include core project files
include pyproject.toml
include README.md
include LICENSE
include CHANGELOG.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include SECURITY.md
include SUPPORT.md
include ROADMAP.md
include .env.example

# Include package data
recursive-include src/flaxon *.py
recursive-include tests *.py
recursive-include tests/fixtures *.js LICENSE
recursive-include scripts *.py

# Include examples
recursive-include examples *.py
recursive-include examples *.html
recursive-include examples *.json
recursive-include examples *.md

# Include static assets
include src/flaxon/py.typed

# Exclude unnecessary files
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .git
global-exclude .github
global-exclude .venv
global-exclude .pytest_cache
global-exclude .mypy_cache
global-exclude .ruff_cache
global-exclude .coverage
global-exclude *.log
global-exclude .DS_Store
global-exclude *.egg-info

# Explicitly exclude the docs folder from PyPI uploads
prune docs