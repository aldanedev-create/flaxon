{% extends "layouts/base.jinja" %}{% block content %}<section class="page-heading"><div><p class="eyebrow">REVIEW QUEUE</p><h1>Alerts</h1><p class="muted">Deterministic policy decisions with human-readable explanations.</p></div></section><section class="cards">{% for alert in alerts %}<article class="alert-card {{ alert.severity }}"><div><span class="eyebrow">{{ alert.status }} · {{ alert.type }}</span><h2>{{ alert.title }}</h2><p>{{ alert.explanation }}</p><small>{{ alert.timestamp }} · {{ '%.0f'|format(alert.confidence * 100) }}% confidence</small></div><div class="alert-actions"><button data-alert="{{ alert.id }}" data-action="review">Review</button><button data-alert="{{ alert.id }}" data-action="dismiss">Dismiss</button></div></article>{% else %}<p class="empty">No alerts yet.</p>{% endfor %}</section>{% endblock %}
