{% extends "layouts/base.jinja" %}
{% block content %}
<section class="page-heading"><div><p class="eyebrow">LIVE OPERATIONS</p><h1>Activity intelligence</h1><p class="muted">GuardianFlow turns camera signals into clear, reviewable activity.</p></div><div class="demo-actions"><button data-demo="package_delivery">Simulate delivery</button><button data-demo="package_removal">Simulate removal</button><button data-demo="after_hours">Simulate after-hours</button></div></section>
<section class="stats"><article><span>Events today</span><strong>{{ summary.events }}</strong></article><article><span>New alerts</span><strong>{{ summary.alerts }}</strong></article><article><span>Cameras online</span><strong>{{ summary.cameras }}</strong></article><article><span>Vision facts</span><strong>{{ summary.facts }}</strong></article></section>
<div class="dashboard-grid"><section class="panel wide"><div class="panel-heading"><h2>Live activity</h2><span class="live-pill"><i></i> Live</span></div><div id="live-feed" class="feed">{% for event in events %}<div class="feed-row"><span class="dot"></span><div><strong>{{ event.type|replace('_', ' ')|title }}</strong><small>{{ event.camera_id }} / {{ event.timestamp.strftime('%H:%M:%S') }}</small></div></div>{% else %}<p class="empty">Use a demo action to send the first camera sequence.</p>{% endfor %}</div></section><section class="panel"><div class="panel-heading"><h2>Intelligence</h2></div>{% if alerts %}{% for alert in alerts[:3] %}<div class="alert-row {{ alert.severity }}"><strong>{{ alert.title }}</strong><span>{{ alert.explanation }}</span></div>{% endfor %}{% else %}<p class="empty">No correlated activity yet.</p>{% endif %}</section></div>
<section class="panel"><div class="panel-heading"><h2>Event graph</h2><span class="muted">Front door sequence</span></div><div class="graph">{% for event in graph[-4:] %}<div class="graph-step"><span>{{ event.type|replace('_', ' ')|title }}</span>{% if not loop.last %}<b>-></b>{% endif %}</div>{% else %}<p class="empty">The event relationship will appear here.</p>{% endfor %}</div></section>
{% endblock %}
