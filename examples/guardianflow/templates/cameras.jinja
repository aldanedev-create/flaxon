{% extends "layouts/base.jinja" %}{% block content %}<section class="page-heading"><div><p class="eyebrow">DEVICES</p><h1>Cameras</h1><p class="muted">Camera status from the event boundary.</p></div></section><section class="cards">{% for camera in cameras %}<article class="camera-card"><span class="camera-icon">⌂</span><div><h2>{{ camera.name }}</h2><p>{{ camera.location }}</p></div><span class="online">{{ camera.status }}</span></article>{% else %}<p class="empty">No cameras configured.</p>{% endfor %}</section>{% endblock %}
