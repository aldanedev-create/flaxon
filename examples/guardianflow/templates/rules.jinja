{% extends "layouts/base.jinja" %}{% block content %}<section class="page-heading"><div><p class="eyebrow">POLICY ENGINE</p><h1>Rules</h1><p class="muted">YAML policies keep detection separate from decisions.</p></div></section><section class="cards">{% for rule in rules %}<article class="rule-card"><span class="rule-name">{{ rule.name|replace('_', ' ')|title }}</span><h2>{{ rule.result_type|replace('_', ' ')|title }}</h2><p>Sequence: {{ rule.conditions|join(' → ') }}</p><small>Window: {{ rule.within_seconds }} seconds{% if rule.schedule %} · {{ rule.schedule.start }} to {{ rule.schedule.end }}{% endif %}</small></article>{% endfor %}</section>{% endblock %}
