{% extends "layouts/base.jinja" %}{% block content %}<section class="page-heading"><div><p class="eyebrow">TELEMETRY</p><h1>Event stream</h1><p class="muted">Normalized camera events before correlation.</p></div></section><section class="panel"><div class="feed">{% for event in events %}<div class="feed-row"><span class="dot"></span><div><strong>{{ event.type|replace('_', ' ')|title }}</strong><small>{{ event.camera_id }} · {{ event.timestamp }} · confidence {{ '%.0f'|format(event.confidence * 100) }}%</small></div></div>{% else %}<p class="empty">No events have been received.</p>{% endfor %}</div></section>{% endblock %}
