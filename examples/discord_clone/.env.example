# Discord-clone example — copy to .env and fill in. NEVER commit .env.
FLAXON_DEBUG=true
FLAXON_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
FLAXON_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite is fine for local dev and tests.
DATABASE_URL=sqlite://data/discord.sqlite3
# Leave empty to run single-worker without Redis. Set to enable cross-worker
# broadcast (e.g. redis://127.0.0.1:6379/0).
REDIS_URL=
