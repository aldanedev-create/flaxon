import pytest
from flaxon.testing import TestClient

from app import create_app
from modules.items.module import store


@pytest.fixture
def client():
    store.clear()
    return TestClient(create_app())


def test_index_and_health(client):
    assert client.get("/").json()["name"] == __PROJECT_NAME_LITERAL__
    assert client.get("/health").status_code == 200


def test_item_lifecycle(client):
    created = client.post("/api/items/", json_data={"name": "  First  "})
    assert created.status_code == 201
    assert created.json() == {"id": 1, "name": "First"}
    assert client.get("/api/items/1").json()["name"] == "First"
    assert client.get("/api/items/").json() == {"items": [created.json()]}
    assert client.delete("/api/items/1").status_code == 200
    assert client.get("/api/items/1").status_code == 404


@pytest.mark.parametrize("payload", [{}, {"name": ""}, {"name": "   "}, {"name": 5}])
def test_invalid_item_is_rejected(client, payload):
    assert client.post("/api/items/", json_data=payload).status_code == 400
    assert client.get("/api/items/").json() == {"items": []}
