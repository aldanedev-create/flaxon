"""A modular JSON API. Add a feature by creating a module and mounting it here."""
import settings
from flaxon import Flaxon
from flaxon.middleware import TrustedHostsMiddleware
from modules.items.module import items


def create_app() -> Flaxon:
    app = Flaxon(
        settings.PROJECT_NAME,
        debug=settings.DEBUG,
        openapi={"title": settings.PROJECT_NAME, "version": "0.1.0"},
    )
    app.add_middleware(TrustedHostsMiddleware, allowed_hosts=settings.ALLOWED_HOSTS)
    app.mount_module(items, prefix="/api/items")

    @app.get("/")
    async def index():
        return {"name": settings.PROJECT_NAME, "docs": "/docs", "health": "/health"}

    return app


app = create_app()
