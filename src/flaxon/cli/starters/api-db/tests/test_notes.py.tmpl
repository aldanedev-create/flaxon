import pytest
from app import create_app


@pytest.fixture
async def app():
    application = create_app()
    await application.lifecycle.startup()
    with application.db.bind():
        await application.db.context.generate_schemas()
        yield application
    await application.lifecycle.shutdown()


@pytest.mark.asyncio
async def test_note_lifecycle(app):
    import httpx

    transport = httpx.ASGITransport(app=app)
    async with httpx.AsyncClient(transport=transport, base_url="http://testserver") as client:
        created = await client.post("/api/notes/", json={"title": " Hello ", "body": "World"})
        assert created.status_code == 201
        note = created.json()
        assert note["title"] == "Hello"
        assert (await client.get(f"/api/notes/{note['id']}")).json()["body"] == "World"
        assert [n["id"] for n in (await client.get("/api/notes/")).json()["notes"]] == [note["id"]]
        assert (await client.delete(f"/api/notes/{note['id']}")).status_code == 200
        assert (await client.get(f"/api/notes/{note['id']}")).status_code == 404


@pytest.mark.asyncio
@pytest.mark.parametrize("payload", [{}, {"title": ""}, {"title": "x" * 201}, {"title": "ok", "body": 1}])
async def test_invalid_notes_are_rejected(app, payload):
    import httpx

    transport = httpx.ASGITransport(app=app)
    async with httpx.AsyncClient(transport=transport, base_url="http://testserver") as client:
        assert (await client.post("/api/notes/", json=payload)).status_code == 400
