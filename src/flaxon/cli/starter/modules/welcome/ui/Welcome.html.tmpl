<script lang="ts">
import { fetchStatus } from "./api.ts";
export default {
  props: ["projectName"],
  data() {
    return { busy: false, message: "" };
  },
  methods: {
    async checkAPI() {
      this.busy = true;
      try {
        const result = await fetchStatus();
        this.message = `${result.message} Flaxon ${result.version}.`;
      } catch (error) {
        this.message = String(error);
      } finally {
        this.busy = false;
      }
    },
  },
};
</script>
