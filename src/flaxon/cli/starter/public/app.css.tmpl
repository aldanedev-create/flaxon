:root {
  font-family:
    system-ui,
    -apple-system,
    "Segoe UI",
    sans-serif;
  color-scheme: light;
  background: #ffffff;
  color: #233f32;
}
body {
  margin: 0;
}
* {
  box-sizing: border-box;
}
a {
  color: #176d49;
  text-underline-offset: 4px;
}
a:hover {
  color: #0f5035;
}
button {
  font: inherit;
  font-size: 14px;
  background: #176d49;
  color: #fff;
  border: 0;
  border-radius: 6px;
  padding: 12px 16px;
  cursor: pointer;
}
button:disabled {
  opacity: 0.65;
  cursor: wait;
}
a:focus-visible,
button:focus-visible {
  outline: 3px solid #23835b;
  outline-offset: 4px;
}
code {
  font-family: ui-monospace, monospace;
  font-size: 0.9em;
}
