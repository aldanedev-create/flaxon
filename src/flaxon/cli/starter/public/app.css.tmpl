:root {
  font-family:
    system-ui,
    -apple-system,
    Segoe UI,
    sans-serif;
  background: #0e1c2c;
  color: #e9f0fa;
  color-scheme: dark;
}
body {
  margin: 0;
}
* {
  box-sizing: border-box;
}
button {
  font: inherit;
  font-size: 13px;
  background: #a2e9c7;
  color: #163b2b;
  border: 0;
  border-radius: 8px;
  padding: 13px 20px;
  cursor: pointer;
  font-weight: 600;
}
button:disabled {
  opacity: 0.6;
  cursor: wait;
}
a:focus-visible,
button:focus-visible {
  outline: 2px solid #b6f6d7;
  outline-offset: 5px;
}
code {
  font-family: ui-monospace, monospace;
  font-size: 0.9em;
}
